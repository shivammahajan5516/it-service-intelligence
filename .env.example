# Copy to .env and fill in. .env is git-ignored - never commit real credentials.

# ---- PostgreSQL connection ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=it_service_intelligence

# Admin account used ONLY by database/build_database.* to create and load the database.
#   Windows installer: user "postgres" + the password you chose during install
#   macOS Homebrew:    leave both blank (your macOS user is the superuser, no password)
#   Linux (apt):       see docs/SETUP.md section 5
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Read-only account the API and Power BI use (created by the build script).
# Choose your own password.
DB_APP_USER=itsi_app
DB_APP_PASSWORD=change-me-to-something-long

# ---- Backend (milestone 4) ----
API_CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ---- Frontend (milestone 5) ----
VITE_API_BASE_URL=http://localhost:8000
