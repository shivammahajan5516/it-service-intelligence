  "background": "#ffffff",
  "foreground": "#14212b",
  "tableAccent": "#0f5e6b",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#184f95",
  "center": "#6da7ec",
  "minimum": "#eef4fc",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#14212b" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#46535c" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#14212b" }
