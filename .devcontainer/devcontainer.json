{
  "name": "IT Service Intelligence",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [
    5432,
    8000,
    5173
  ],
  "portsAttributes": {
    "8000": {
      "label": "FastAPI"
    },
    "5173": {
      "label": "Dashboard (Vite)"
    },
    "5432": {
      "label": "PostgreSQL",
      "onAutoForward": "ignore"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y postgresql postgresql-contrib && bash scripts/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "mechatroner.rainbow-csv",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "bierner.markdown-mermaid"
      ]
    }
  }
}
