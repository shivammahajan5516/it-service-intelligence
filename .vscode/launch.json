{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Generate dataset (seed 42)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_dataset.py",
      "args": [
        "--seed",
        "42"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Validate dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/validate_dataset.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run current Python file",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Analytics: run analysis",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analytics/run_analysis.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
